<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Maven project coordinates and version. -->
    <groupId>org.example</groupId>
    <artifactId>media-hub</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Compile the project using JDK 24. -->
        <maven.compiler.release>24</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Use the same version for all JavaFX modules. -->
        <javafx.version>24.0.2</javafx.version>
    </properties>

    <dependencies>
        <!-- UI controls such as buttons, labels, and lists. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Audio and video playback support. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Provides the javafx:run Maven goal. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- Fully qualified name of the JavaFX entry point. -->
                    <mainClass>org.example.mediahub.MainApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>